&uart0 {
  status = "okay";
  compatible = "nordic,nrf-uarte";
  current-speed = <1000000>;
  pinctrl-0 = <&uart0_default>;
  pinctrl-1 = <&uart0_sleep>;
  pinctrl-names = "default", "sleep";
  hw-flow-control;
};

/* Must stay in sync with ../../../boards/circuitdojo_feather_nrf9160_ns.overlay
 * -- see that file's comment for why this is devicetree-native rather than
 * Partition-Manager-driven as of the NCS 3.4.0 bump. */
/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &tfm_ps_partition;
/delete-node/ &tfm_its_partition;
/delete-node/ &tfm_otp_partition;
/delete-node/ &storage_partition;

&flash0 {
  partitions {
    boot_partition: partition@0 {
      compatible = "zephyr,mapped-partition";
      label = "mcuboot";
      reg = <0x00000000 0x10000>;
    };

    slot0_partition: partition@10000 {
      compatible = "zephyr,mapped-partition";
      label = "image-0";
      reg = <0x00010000 0x000d0000>;
      ranges = <0x0 0x10000 0xd0000>;
      #address-cells = <1>;
      #size-cells = <1>;

      slot0_s_partition: partition@0 {
        compatible = "zephyr,mapped-partition";
        label = "image-0-secure";
        reg = <0x00000000 0x00038000>;
      };

      slot0_ns_partition: partition@38000 {
        compatible = "zephyr,mapped-partition";
        label = "image-0-nonsecure";
        reg = <0x00038000 0x00098000>;
      };
    };

    tfm_ps_partition: partition@e0000 {
      compatible = "zephyr,mapped-partition";
      label = "tfm-ps";
      reg = <0x000e0000 0x00002000>;
    };

    tfm_its_partition: partition@e2000 {
      compatible = "zephyr,mapped-partition";
      label = "tfm-its";
      reg = <0x000e2000 0x00002000>;
    };

    tfm_otp_partition: partition@e4000 {
      compatible = "zephyr,mapped-partition";
      label = "tfm-otp";
      reg = <0x000e4000 0x00002000>;
    };

    /* Starts at the next 32 KB boundary after TF-M's secure storage, not
     * immediately at 0xe6000: the nRF9160 SPU assigns flash security in
     * 32 KB blocks, so a nonsecure partition starting mid-block would force
     * the whole 0xe0000-0xe8000 block nonsecure and expose TF-M's PS/ITS/
     * NV-counter data to the app (the old pm_static.yml's EMPTY_* entries
     * existed precisely to keep these boundaries block-aligned). The 8 KB
     * at 0xe6000-0xe8000 stays reserved secure-side slack. */
    storage_partition: partition@e8000 {
      compatible = "zephyr,mapped-partition";
      label = "storage";
      reg = <0x000e8000 0x00018000>;
    };
  };
};

&w25q32jv {
  partitions {
    compatible = "fixed-partitions";
    #address-cells = <1>;
    #size-cells = <1>;

    /* No secure/nonsecure sub-split -- see the app overlay's matching
     * comment: "zephyr,mapped-partition" requires a soc-nv-flash parent,
     * which external SPI flash isn't, and this slot is never XIP-executed
     * in place anyway. */
    slot1_partition: partition@0 {
      label = "image-1";
      reg = <0x00000000 0x000d0000>;
    };
  };
};

/ {
  chosen {
    /* Without Partition Manager, MCUboot's own link address comes from
     * zephyr,code-partition. The board dts defaults this to slot0_partition
     * (the application slot at 0x10000) -- MCUboot must link into its own
     * 64 KB boot_partition at 0x0 or it lands on top of the app image. */
    zephyr,code-partition = &boot_partition;
    nordic,pm-ext-flash = &w25q32jv;
    zephyr,console = &uart0;
    zephyr,shell-uart = &uart0;
    zephyr,uart-mcumgr = &uart0;
  };
};
